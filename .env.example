# Telegram bot UI
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram MTProto worker (optional; public Telegram works without these)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# VK API (required only when a vk_wall source is enabled)
VK_ACCESS_TOKEN=

# Required when web listens on 0.0.0.0. Browser username may be anything; password is this token.
WEB_AUTH_TOKEN=

# Optional semantic refinement. Disabled by default; rule-based classification remains the fallback.
OPENAI_CLASSIFIER_ENABLED=0
OPENAI_CLASSIFIER_MODEL=
OPENAI_API_KEY=
